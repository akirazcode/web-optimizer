{
  "name": "web-optimizer-cli",
  "version": "1.0.0",
  "description": "Bun CLI to optimize and convert images to WebP and videos to WebM",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "web-optimizer": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts --help",
    "start": "bun run src/index.ts",
    "check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
